# Copie para .env.local. Nunca envie credenciais reais ao GitHub.
# DATABASE_URL deve ser uma conexão privada PostgreSQL usada somente no servidor.
# Não use as chaves anon/publishable nem exponha service_role no navegador.
DATABASE_URL=

# URL exata da aplicação, sem barra final
APP_URL=http://localhost:3000

# Gere segredos independentes e aleatórios. Mantenha-os apenas nas variáveis do servidor.
# Exemplo: openssl rand -hex 32
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# E-mail transacional via Resend
EMAIL_API_KEY=
EMAIL_FROM=

# OAuth Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cadastro é desabilitado por padrão e limitado aos Gmail autorizados.
ALLOW_REGISTRATION=false
ADMIN_ALLOWED_EMAILS=
